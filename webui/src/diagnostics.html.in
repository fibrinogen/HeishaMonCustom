<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1'>
<title>Heisha Monitor</title>
<link rel='stylesheet' href='/webui/styles.css?v={{WEBUI_VERSION}}'>
<script src='/webui/common.js?v={{WEBUI_VERSION}}'></script>
</head>
<body>
<div class='sidemenu-overlay' id='menuOverlay' onclick='closeMenu()'></div>
<aside class='sidemenu' id='sideMenu'>
  <div class='sidemenu-header'><h2>HeishaMon</h2><p id='sideVersion'>Custom build {{CUSTOM_VERSION}}<br><small>Base: {{BASE_VERSION}}</small></p></div>
  <div class='theme-toggle'><label class='theme-toggle-label'><span class='nav-icon'>☀</span> Dark Mode</label><label class='theme-switch'><input type='checkbox' id='darkModeToggle' onchange='toggleDarkMode()'><span class='theme-slider'></span></label></div>
  <nav class='sidemenu-nav' id='sideNav'></nav>
  <div class='sidemenu-footer'><a href='https://github.com/heishamon/HeishaMon' target='_blank'>GitHub</a></div>
</aside>
<header class='topbar'><div class='topbar-left'><button class='hamburger' onclick='toggleMenu()'>&#9776;</button><a class='topbar-logo' href='/'>Heisha<span>Mon</span></a></div><div class='topbar-right'></div></header>
<main class='main-content diagnostics-page'>
  <div class='diagnostics-heading'><div><h1>Diagnostics</h1><p class='diagnostics-muted'>Read-only live data and controller health. Operational controls remain on Dashboard and WP Configuration.</p></div><div id='status' class='diagnostics-status'>Loading…</div></div>
  <nav class='tabnav diagnostics-tabs' aria-label='Diagnostics sections'>
    <button type='button' class='active' data-diagnostics-tab='wp' onclick="showDiagnosticsTab('wp')">WP Diagnostics</button>
    <button type='button' data-diagnostics-tab='esp' onclick="showDiagnosticsTab('esp')">ESP Diagnostics</button>
    <button type='button' data-diagnostics-tab='events' onclick="showDiagnosticsTab('events')">Event Log</button>
  </nav>
  <section id='diagnostics-wp' class='tab-pane active'>
    <div id='wpCards' class='diagnostics-grid'></div>
    <details class='panel diagnostics-raw'><summary>Raw Panasonic values</summary><pre id='raw'>Loading…</pre></details>
  </section>
  <section id='diagnostics-esp' class='tab-pane'>
    <div id='espCards' class='diagnostics-grid'></div>
  </section>
  <section id='diagnostics-events' class='tab-pane'>
    <section class='panel diagnostics-event-log'><div class='panel-header'><h3>Persistent event log</h3><span id='eventLogStatus' class='diagnostics-muted'>Loading…</span></div><div class='diagnostics-event-toolbar'><label>Preset <select id='eventRange' onchange='setEventRange(true)'><option value='24h' selected>Last 24 h</option><option value='7d'>Last 7 days</option><option value='30d'>Last 30 days</option><option value='90d'>Last 90 days</option><option value='custom'>Custom</option></select></label><label>Start <input id='eventStart' type='datetime-local' onchange='eventRangeCustom()'></label><label>End <input id='eventEnd' type='datetime-local' onchange='eventRangeCustom()'></label><label>Type <select id='eventType' onchange='renderEventLog()'><option value=''>All</option><option value='scheduler'>Scheduler</option><option value='smart_dhw'>Smart DHW</option><option value='system'>System</option><option value='communication'>Communication</option><option value='mqtt'>MQTT</option><option value='error_appeared'>Errors</option></select></label><button type='button' class='dashboard-button' onclick='loadPersistentEvents()'>Load events</button><a id='eventLogDownload' class='dashboard-button' download='heishamon-events.csv'>Download shown CSV</a></div><div class='diagnostics-event-wrap'><table class='diagnostics-event-table'><thead><tr><th>Time</th><th>Type</th><th>Message</th></tr></thead><tbody id='eventLogRows'><tr><td colspan='3'>Loading…</td></tr></tbody></table></div></section>
  </section>
</main>
<script>
var esc=hmEscape;
function val(v,unit){return v===null||v===undefined?'N/A':esc(v)+(unit||'')}
function row(k,v){return '<div class="diagnostics-row"><span>'+esc(k)+'</span><span class="diagnostics-value">'+v+'</span></div>'}
function card(title,rows){return '<section class="panel diagnostics-card"><div class="panel-header"><h3>'+title+'</h3></div><div class="diagnostics-rows">'+rows.join('')+'</div></section>'}
var lastDiagnostics=null;
function render(d){lastDiagnostics=d;var s=d.system||{},o=d.operation||{},h=d.hydraulics||{},c=d.control||{},z1=c.zone1HeatRequest||{},cs=c.heatingCurveShift||{},w=d.dhw||{},n=d.counters||{},sd=d.sd||{};
 document.getElementById('status').innerHTML='Panasonic: <b class="'+(s.panasonic&&s.panasonic.fresh?'diagnostics-ok':'diagnostics-bad')+'">'+esc(s.panasonic?s.panasonic.status:'NO DATA')+'</b> · Last frame: '+val(s.panasonic&&s.panasonic.ageSeconds,' s');
 document.getElementById('wpCards').innerHTML=card('WP COMMUNICATION & OPERATION',[row('Interpreted state',val(o.state)),row('Operating mode',val(o.mode)),row('Compressor',o.compressorRunning?'Running':'Stopped'),row('Compressor frequency',val(o.compressorFrequency,' Hz')),row('Current runtime',val(o.currentRuntimeSeconds,' s')),row('3-way valve',val(o.valve)),row('Pump speed',val(o.pumpSpeed,' rpm')),row('Fan 1',val(o.fan1,' rpm'))])+card('HYDRAULICS',[row('Inlet',val(h.inlet,' °C')),row('Outlet',val(h.outlet,' °C')),row('Target',val(h.target,' °C')),row('Water flow',val(h.flow,' l/min')),row('Delta T',val(h.deltaT,' K')),row('Target error',val(h.targetError,' K')),row('Delta-T error',val(h.deltaTError,' K')),row('Calculated thermal power',val(h.calculatedThermalPowerKw,' kW'))])+card('CONTROL CONTEXT',[row('Zone 1 raw TOP27',val(z1.rawValue)),row(z1.label||'Zone 1 request',val(z1.value,z1.unit?' '+z1.unit:'')),row('Heating mode',val(z1.heatingModeLabel||c.heatingMode)),row('Zone 1 sensor setting',val(z1.sensorSettingLabel||z1.sensorSetting)),row('Heating-off outdoor temp',val(c.heatingOffOutside,' °C')),row('Room temperature',val(c.roomTemperature,' °C'))])+card('DHW',[row('DHW actual',val(w.actual,' °C')),row('DHW target',val(w.target,' °C')),row('DHW active',w.active?'Yes':'No'),row('Force DHW',val(w.forceState)),row('Smart DHW','See Smart DHW page')])+card('LIFETIME & CYCLE COUNTERS',[row('Panasonic operation hours',val(n.panasonicOperationHours)),row('Panasonic operation counter',val(n.panasonicOperationCounter)),row('Compressor starts since boot',val(n.compressorStartsSinceBoot)),row('Current cycle',val(n.currentCycleSeconds,' s')),row('Previous cycle',val(n.previousCycleSeconds,' s')),row('Average cycle',val(n.averageCycleSeconds,' s'))])+card('HEATING CURVE SHIFT',[row('Requested shift',val(cs.shift,' K')),row('Implementation',val(cs.implementationLabel)),row('Base high',val(cs.baseTargetHigh,' °C')),row('Base low',val(cs.baseTargetLow,' °C')),row('Effective high',val(cs.effectiveTargetHigh,' °C')),row('Effective low',val(cs.effectiveTargetLow,' °C')),row('External mismatch',cs.externalMismatch?'Yes':'No')])+hardwareDiagnosticsCards();
 document.getElementById('espCards').innerHTML=card('CONNECTIVITY & TIME',[row('WiFi',s.wifi?'Connected':'Offline'),row('Ethernet',s.ethernet?'Connected':'Offline'),row('MQTT',s.mqtt?'Connected':'Offline'),row('NTP',s.ntp?'Synchronized':'Unavailable'),row('Uptime',val(s.uptimeSeconds,' s')),row('Reset reason',val(s.resetReason))])+card('MEMORY & FIRMWARE',[row('Free heap',val(s.freeHeap,' B')),row('PSRAM',s.psramFound?val(s.freePsram,' B free'):'Not available'),row('Custom firmware',val(s.customVersion)),row('Upstream base',val(s.heishamonBaseVersion)),row('Firmware identifier',val(s.firmware))])+card('HISTORY & SD STORAGE',[row('RAM samples',val((d.history||{}).sampleCount)+' / '+val((d.history||{}).capacity)),row('Sample interval',val((d.history||{}).intervalSeconds,' s')),row('RAM memory',val((d.history||{}).sampleMemoryBytes,' B')),row('SD support',sd.support?'Enabled':'Disabled'),row('SD card',sd.present?'Present':'Not present'),row('History logging',sd.active?'Active':'RAM only'),row('SD interface',val(sd.interface)),row('SD bus',val(sd.busFrequencyKHz,' kHz')),row('SD writer',sd.writerBusy?('Busy: '+val(sd.writerPhase)):'Idle'),row('Last SD write',val(sd.lastWriteSecondsAgo,' s ago')),row('Retention',sd.retentionDays===0?'Unlimited':val(sd.retentionDays,' days')),row('SD error',val(sd.lastError))]);
 document.getElementById('raw').textContent=JSON.stringify(d,null,2);
}
var hardwareDiagnostics=null;
function hardwareDiagnosticsCards(){if(hardwareDiagnostics===null)return card('HEAT PUMP IDENTIFICATION',[row('Status','Loading hardware information…')]);var d=hardwareDiagnostics;return card('HEAT PUMP IDENTIFICATION',[row('Model',val(d.model)),row('Type',val(d.type)),row('Heat capacity',val(d.capacity)),row('Power connection',val(d.power))])+card('INSTALLED OPTIONS',[row('Zone 2 control method / sensor',val(d.zone2Sensor)),row('Room heater state',val(d.roomHeaterState)),row('Buffer installed',val(d.bufferInstalled)),row('DHW installed',val(d.dhwInstalled)),row('DHW heater state',val(d.dhwHeaterState)),row('Cooling mode',val(d.coolingMode)),row('Solar mode',val(d.solarMode)),row('Pump flowrate mode',val(d.pumpFlowMode)),row('Liquid type',val(d.liquidType)),row('Alternative external sensor',val(d.externalSensor)),row('Anti-freeze mode',val(d.antiFreezeMode))]);}
function loadHardwareDiagnostics(){if(hardwareDiagnostics!==null)return;fetch('/hardwareapi',{cache:'no-store'}).then(function(r){if(!r.ok)throw Error(r.status);return r.json()}).then(function(d){hardwareDiagnostics=d;if(lastDiagnostics)render(lastDiagnostics)}).catch(function(e){hardwareDiagnostics={model:'Unavailable: '+e.message};if(lastDiagnostics)render(lastDiagnostics)})}
function showDiagnosticsTab(tab){var names=['wp','esp','events'];names.forEach(function(name,index){var active=name===tab;document.getElementById('diagnostics-'+name).classList.toggle('active',active);var button=document.querySelectorAll('[data-diagnostics-tab]')[index];button.classList.toggle('active',active);button.setAttribute('aria-selected',active?'true':'false');});if(tab==='events'&&persistentEvents.length===0)loadPersistentEvents()}
var persistentEvents=[];
function inputDateTime(value){var z=function(v){return String(v).padStart(2,'0')};return value.getFullYear()+'-'+z(value.getMonth()+1)+'-'+z(value.getDate())+'T'+z(value.getHours())+':'+z(value.getMinutes())}
function setEventRange(load){var seconds={"24h":86400,"7d":604800,"30d":2592000,"90d":7776000}[document.getElementById('eventRange').value];if(!seconds)return;var end=new Date(),start=new Date(end.getTime()-seconds*1000);document.getElementById('eventStart').value=inputDateTime(start);document.getElementById('eventEnd').value=inputDateTime(end);if(load)loadPersistentEvents()}
function eventRangeCustom(){document.getElementById('eventRange').value='custom'}
function eventTimestamp(id){var value=new Date(document.getElementById(id).value).getTime();return Number.isFinite(value)?Math.floor(value/1000):0}
function eventLogUrl(path){var start=eventTimestamp('eventStart'),end=eventTimestamp('eventEnd');return path+'?start='+start+'&end='+end}
function renderEventLog(){var type=document.getElementById('eventType').value,rows=(persistentEvents||[]).slice().reverse().filter(function(e){return !type||e.type===type});document.getElementById('eventLogRows').innerHTML=rows.length?rows.map(function(e){return '<tr><td>'+esc(new Date(Number(e.t)*1000).toLocaleString())+'</td><td>'+esc(e.type)+'</td><td>'+esc(e.message)+'</td></tr>'}).join(''):'<tr><td colspan="3">No matching persistent events</td></tr>'}
function loadPersistentEvents(){var status=document.getElementById('eventLogStatus'),start=eventTimestamp('eventStart'),end=eventTimestamp('eventEnd');if(!start||!end||end<=start||end-start>90*86400){status.textContent='Select a valid period of up to 90 days.';return}status.textContent='Reading SD…';document.getElementById('eventLogDownload').href=eventLogUrl('/eventlogcsv');fetch(eventLogUrl('/eventlogapi'),{cache:'no-store'}).then(function(r){if(!r.ok)throw Error(r.status);return r.json()}).then(function(d){if(d.error)throw Error(d.error);persistentEvents=d.events||[];status.textContent=(d.eventCount||0)+' events (latest 100 shown)';renderEventLog()}).catch(function(e){status.textContent='Event log unavailable: '+e.message})}
function refresh(){fetch('/diagnosticsapi',{cache:'no-store'}).then(function(r){if(!r.ok)throw Error(r.status);return r.json()}).then(render).catch(function(e){document.getElementById('status').textContent='Diagnostics unavailable: '+e.message})}
setEventRange(false);document.title='Diagnostics - HeishaMon';refresh();loadHardwareDiagnostics();setInterval(refresh,5000);
</script>
</body>
</html>
