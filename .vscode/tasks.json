{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Firmware: Build",
            "type": "process",
            "command": "${workspaceFolder}/../tools/pio",
            "args": ["run"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$platformio"
        },
        {
            "label": "Firmware: Clean",
            "type": "process",
            "command": "${workspaceFolder}/../tools/pio",
            "args": ["run", "-t", "clean"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$platformio"
        }
    ]
}
